// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  country   String?
  timezone  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks        Task[]
  timeTrackers TimeTracker[]
  apiKeys      ApiKey[]

  @@map("users")
}

model Task {
  id    String @id @default(cuid())
  value String
  label String
  color String
  /// Manual sort order within a user's list, ascending. Gaps are allowed —
  /// only the relative order matters, and a reorder rewrites the whole list.
  position  Int      @default(0)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  timeTrackers TimeTracker[]

  @@index([userId, position])
  @@map("tasks")
}

enum TimeTrackerStatus {
  IN_PROGRESS
  PAUSED
  COMPLETED
}

model TimeTracker {
  id           String            @id @default(cuid())
  userId       String
  taskId       String
  startTime    DateTime?
  endTime      DateTime?
  minutesSpent Int               @default(0)
  status       TimeTrackerStatus @default(IN_PROGRESS)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([taskId])
  @@map("time_trackers")
}

model ApiKey {
  id String @id @default(cuid())
  /// Human label, so a key can be recognised in the UI without revealing it.
  name String
  /// SHA-256 of the issued token. The token itself is shown once, at creation,
  /// and never stored — a leaked database can't be replayed against the API.
  hashedKey String @unique
  /// Leading characters of the token, kept in the clear so the list can show
  /// something like "to_live_a1b2…" beside the label.
  prefix String
  /// Null means the key never expires.
  expiresAt DateTime?
  /// Set instead of deleting the row, so an audit trail survives revocation.
  revokedAt  DateTime?
  lastUsedAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@map("api_keys")
}
